#!/usr/bin/env python3
"""Install the upstream app installer as a managed Vicinae bundle."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import tempfile


root = Path(__file__).resolve().parents[2]
source = root / 'package-manager/launcher-extension/dist'
data_home = Path(os.environ.get('XDG_DATA_HOME') or Path.home() / '.local/share')
# Vicinae combines this directory name with the manifest author for its command ID.
target = data_home / 'vicinae/extensions/pond-pm-extension'
manifest_name = '.pond-fedora-manifest.json'


def files(directory):
    result = {}
    for path in directory.rglob('*'):
        if path.is_symlink():
            raise SystemExit(f'Refusing symbolic link: {path}')
        if path.is_file() and path.name != manifest_name:
            result[path.relative_to(directory).as_posix()] = hashlib.sha256(path.read_bytes()).hexdigest()
    return result


metadata = json.loads((source / 'package.json').read_text())
if metadata.get('name') != 'pm-extension' or metadata.get('author') != 'bflycomputer':
    raise SystemExit('The built bundle is not the upstream Pond app installer.')
for relative in ('install.js', 'bin/pm-extension-bridge'):
    if not (source / relative).is_file():
        raise SystemExit(f'The built bundle is missing {relative}.')
new = files(source)
if target.is_symlink() or (target.exists() and not target.is_dir()):
    raise SystemExit(f'Refusing to replace {target}.')
if target.exists():
    current = files(target)
    manifest = target / manifest_name
    previous = json.loads(manifest.read_text()) if manifest.exists() else new
    if current != previous:
        raise SystemExit(f'The installed extension has local changes: {target}')
if os.environ.get('POND_DRY_RUN') == '1':
    print(f'Would install {len(new)} bundle files in {target}.')
    raise SystemExit(0)

target.parent.mkdir(parents=True, exist_ok=True)
with tempfile.TemporaryDirectory(prefix='.pond-pm-install-', dir=target.parent) as directory:
    staging = Path(directory)
    bundle = staging / 'bundle'
    shutil.copytree(source, bundle)
    (bundle / manifest_name).write_text(json.dumps(new, indent=2, sort_keys=True) + '\n')
    previous = staging / 'previous'
    if target.exists():
        os.replace(target, previous)
    try:
        os.replace(bundle, target)
    except OSError:
        if previous.exists():
            os.replace(previous, target)
        raise
print(f'Installed the launcher app installer in {target}.')
