From fb55c44283d3eda59dcc23fa5f38131dabe4fd26 Mon Sep 17 00:00:00 2001
From: DillerOFire <niktofe1@gmail.com>
Date: Mon, 2 Nov 2026 15:03:14 +1000
Subject: [PATCH] Use IBM Plex Serif for Pond titles

---
 lockscreen/frontend/Theme.qml               |   5 +-
 shell/Theme.qml                             |   7 +-
 shell/assets/fonts/IBMPlexSerif-Regular.ttf | Bin 0 -> 215400 bytes
 shell/assets/fonts/OFL-IBM-Plex.txt         |  92 ++++++++++++++++++++
 4 files changed, 102 insertions(+), 2 deletions(-)
 create mode 100644 shell/assets/fonts/IBMPlexSerif-Regular.ttf
 create mode 100644 shell/assets/fonts/OFL-IBM-Plex.txt

diff --git a/lockscreen/frontend/Theme.qml b/lockscreen/frontend/Theme.qml
index 64e3d41..eb9bbc4 100644
--- a/lockscreen/frontend/Theme.qml
+++ b/lockscreen/frontend/Theme.qml
@@ -13,6 +13,9 @@ QtObject {
     readonly property color iconDisc: "#f0e5ff"
     readonly property color powerLabel: "#ffc5a7"
 
-    readonly property string displayFont: "Pond Gramercy"
+    readonly property FontLoader titleFont: FontLoader {
+        source: "../../shell/assets/fonts/IBMPlexSerif-Regular.ttf"
+    }
+    readonly property string displayFont: titleFont.status === FontLoader.Ready ? titleFont.name : uiFont
     readonly property string uiFont: "Onest"
 }
diff --git a/shell/Theme.qml b/shell/Theme.qml
index febe91d..97d0bf7 100644
--- a/shell/Theme.qml
+++ b/shell/Theme.qml
@@ -16,6 +16,11 @@ Singleton {
 
   function reload() { themeFile.reload(); }
 
+  FontLoader {
+    id: titleFont
+    source: "assets/fonts/IBMPlexSerif-Regular.ttf"
+  }
+
   FileView {
     id: themeFile
     path: StandardPaths.writableLocation(StandardPaths.ConfigLocation) + "/pond-interface/theme.json"
@@ -84,7 +89,7 @@ Singleton {
   readonly property int mediaRevealDuration: 180
   readonly property int sidebarStrokeWidth: 1
   readonly property string fontFamily: "Onest"
-  readonly property string titleFontFamily: "Pond Gramercy"
+  readonly property string titleFontFamily: titleFont.status === FontLoader.Ready ? titleFont.name : fontFamily
   readonly property string plexFontFamily: "IBM Plex Mono"
 
   function collapseWidth(progress) { return ramp(progress, 0, 0.56); }
diff --git a/shell/assets/fonts/IBMPlexSerif-Regular.ttf b/shell/assets/fonts/IBMPlexSerif-Regular.ttf
new file mode 100644
index 0000000000000000000000000000000000000000..6265dfe413d27435400b0b9a3abca39b50ba31ae
