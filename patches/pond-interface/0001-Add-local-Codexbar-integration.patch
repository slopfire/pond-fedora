+              color: Model.ringColor(line.entry, modelData, root.theme)
+              trackColor: root.theme.track
+              timeLeft: Model.windowLeft(modelData, root.state.nowMs)
+            }
+          }
+          Text {
+            visible: line.windows.length === 0
+            text: line.failed ? "" : Model.headline(line.entry) ? Model.headline(line.entry).text : "—"
+            color: root.theme.ink
+            opacity: 0.6
+            font.family: Shell.Theme.plexFontFamily
+            font.pixelSize: 10
+          }
+        }
+
+        HoverHandler {
+          id: rowPointer
+          cursorShape: Qt.PointingHandCursor
+        }
+        TapHandler {
+          onTapped: root.rowClicked(line.entry)
+        }
+      }
+    }
+  }
+}
diff --git a/shell/codexbar/Gallery.qml b/shell/codexbar/Gallery.qml
new file mode 100644
index 0000000000000000000000000000000000000000..460dba0c23bce28e922ba0d61e38d98788c3f451
--- /dev/null
+++ b/shell/codexbar/Gallery.qml
@@ -0,0 +1,139 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import "CodexBarModel.mjs" as Model
+import ".." as Shell
+
+// The sidebar grid.
+//
+// Expanded: two columns of provider tiles. Every tile leads with the provider
+// mark and one ring per usage window, worst first. Up to `bars` rings per tile.
+// Collapsed: one column of mark plus a single ring, the tile's own tightest
+// window, so the 48 px rail still answers "what is tightest".
+//
+// The grid shows at most `maxTiles` providers, worst first, and collapses the
+// rest into a "+N" tile when `overflow` is on.
+Item {
+  id: root
+
+  required property var state
+  required property real collapseProgress
+  // Shared card surface and colours, from the owning card.
+  required property var theme
+  property int bars: 3
+  property int maxTiles: 6
+  property bool overflow: true
+  property bool panelOpen: false
+  signal tileClicked(var entry)
+  signal ringsPainted
+  // A tile painted; its card may need a capture refresh.
+  property int ringsPaintedCount: 0
+
+  readonly property bool compact: collapseProgress >= 0.56
+  readonly property real widthProgress: Shell.Theme.collapseWidth(collapseProgress)
+  readonly property real heightProgress: Shell.Theme.collapseHeight(collapseProgress)
+
+  // Ring values per provider, computed once per snapshot.
+  // One tile per provider that answers. Failed providers keep their error in
+  // the drawer list only: a grid of red rings says nothing useful.
+  readonly property var tiles: (state.ordered || [])
+      .filter(entry => !Model.isErrorOnly(entry))
+      .map(entry => ({
+        entry,
+        id: entry.id,
+        rings: Model.rings(entry, bars),
+        error: false
+      }))
+  // Rows are capped (four expanded, three compact), so the card stays about
+  // half the sidebar height and never hides the tray card behind it.
+  readonly property int columns: compact ? 1 : 2
+  readonly property int rowCap: compact ? 3 : 4
+  readonly property int capacity: columns * rowCap
+  // One cell of the cap becomes the "+N" tile when providers did not fit.
+  readonly property int visibleCount: Math.min(maxTiles > 0 ? maxTiles : capacity,
+      tiles.length > capacity ? capacity - 1 : capacity)
+  readonly property var shown: tiles.slice(0, visibleCount)
+  readonly property int hidden: tiles.length - shown.length
+  readonly property int cellsVisible: shown.length + (hidden > 0 && overflow ? 1 : 0)
+  readonly property int rows: Math.max(1, Math.ceil(cellsVisible / columns))
+
+  // Cell size: the card width minus the outer padding, split over the columns.
+  // 8 px inside a 156 px card leaves 140 for two columns.
+  readonly property int padding: 8
+  readonly property int gap: Shell.Theme.sidebarCardGap + 2
+  readonly property real cellWidth: Math.floor((Shell.Theme.sidebarCardExpandedWidth
+      - padding * 2 - gap * (columns - 1)) / columns)
+  readonly property real cellHeight: compact ? 40 : 70
+  readonly property real gridWidth: columns * cellWidth + (columns - 1) * gap
+  readonly property real gridHeight: rows * cellHeight + Math.max(0, rows - 1) * gap
+
+  // Both rest states, measured here so the card can sum them without guessing.
+  readonly property int compactRows: Math.max(1, Math.ceil(cellsVisible / columns))
+  implicitWidth: Shell.Theme.sidebarCardExpandedWidth
+  implicitHeight: compact ? compactHeight : expandedHeight
+  readonly property int expandedHeight: padding * 2 + gridHeight
+  readonly property int compactHeight: padding * 2 + compactRows * cellHeight
+      + Math.max(0, compactRows - 1) * gap
+
+  // Explicit positions, no layout parent: a Grid placed inside a Column anchors
+  // itself to the Column. Every position here is arithmetic anyway.
+  Repeater {
+    model: root.cellsVisible
+
+    delegate: Item {
+      id: cell
+      required property int index
+
+      readonly property bool isMore: index >= root.shown.length
+
+      x: Math.round((root.width - root.gridWidth) / 2)
+          + (index % root.columns) * (root.cellWidth + root.gap)
+      y: Math.round((root.height - root.gridHeight) / 2)
+          + Math.floor(index / root.columns) * (root.cellHeight + root.gap)
+      width: root.cellWidth
+      height: root.cellHeight
+
+      Tile {
+        anchors.fill: parent
+        visible: !cell.isMore
+        tile: root.shown[cell.index]
+        compact: root.compact
+        theme: root.theme
+        nowMs: root.state.nowMs
+        onRingsPainted: {
+          root.ringsPaintedCount += 1;
+          root.ringsPainted();
+        }
+        onClicked: root.tileClicked(root.shown[cell.index].entry)
+      }
+
+      // The extra cell: how many providers did not fit. Opens the drawer.
+      Item {
+        anchors.fill: parent
+        visible: cell.isMore
+        Accessible.role: Accessible.Button
+        Accessible.name: "Show " + root.hidden + " more providers"
+        Rectangle {
+          anchors.fill: parent
+          radius: Shell.PanelStyle.rowRadius
+          color: morePointer.hovered ? Shell.Theme.sidebarHoverFill : "transparent"
+        }
+        Text {
+          anchors.centerIn: parent
+          text: "+" + root.hidden
+          color: root.theme.ink
+          opacity: 0.55
+          font.family: Shell.Theme.plexFontFamily
+          font.pixelSize: root.compact ? 11 : 12
+        }
+        HoverHandler {
+          id: morePointer
+          cursorShape: Qt.PointingHandCursor
+        }
+        TapHandler {
+          onTapped: root.tileClicked(null)
+        }
+      }
+    }
+  }
+}
diff --git a/shell/codexbar/List.qml b/shell/codexbar/List.qml
new file mode 100644
index 0000000000000000000000000000000000000000..91cc2ea4152df447bb70a36280427db5aeac626b
--- /dev/null
+++ b/shell/codexbar/List.qml
@@ -0,0 +1,330 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import "CodexBarModel.mjs" as Model
+import "../" as Shell
+
+// First drawer page: every provider, worst first.
+//
+// The height follows the row count so the stack animates to the right size.
+// Opening the panel starts a refresh, so the footer shows progress for the
+// first few seconds. A failed refresh keeps the last good rows on screen and
+// puts the reason in the footer; an empty snapshot shows the error in the body.
+Item {
+  id: root
+
+  property var stackController
+  property bool interactive: true
+  property var selection: ({})
+
+  // Injected by the drawer panel. Named pageState because "state" is the
+  // base Item property.
+  required property var pageState
+  readonly property var rows: pageState.ordered
+  readonly property int rowCount: rows.length
+  readonly property bool waiting: pageState.running && !pageState.loaded
+  readonly property int rowHeight: 54
+  readonly property string footerText: footerMessage()
+  readonly property int listHeight: Math.max(1, rowCount) * rowHeight
+
+  // Shared bar colours. Strings, so the model's colour helpers pass them
+  // through unchanged.
+  readonly property var palette: ({
+    ink: "#FFFFFF",
+    yellow: "#EBE075",
+    red: "#FA6D80",
+    track: "#303030"
+  })
+
+  implicitWidth: Shell.PanelStyle.width
+  implicitHeight: 76 + listHeight + (footerText !== "" ? 30 : 0)
+
+  function footerMessage() {
+    if (pageState.failed && pageState.lastError !== "")
+      return pageState.lastError;
+    if (pageState.running)
+      return pageState.loaded ? "Refreshing" : "Reading usage";
+    if (pageState.costNote !== "")
+      return "Spend history unavailable";
+    return "";
+  }
+
+  function subtitle(entry) {
+    const parts = [];
+    if (entry.plan)
+      parts.push(String(entry.plan));
+    if (entry.account)
+      parts.push(String(entry.account));
+    if (parts.length === 0)
+      parts.push(String(entry.source || ""));
+    if (entry.stale)
+      parts.push("last good " + Model.ageText(entry.updatedAt, pageState.nowMs));
+    return parts.join(" · ");
+  }
+
+  Shell.PanelBackground {
+    anchors.fill: parent
+
+    Image {
+      x: 19.5
+      y: 23.5
+      width: 16
+      height: 16
+      source: Qt.resolvedUrl("assets/tray.svg")
+      sourceSize: Qt.size(32, 32)
+    }
+    Text {
+      x: 43.5
+      y: 19.5
+      text: "CodexBar"
+      color: "white"
+      font.family: Shell.Theme.titleFontFamily
+      font.weight: Font.Normal
+      font.pixelSize: 20
+    }
+    Row {
+      x: 241.5
+      y: 19.5
+      width: 54
+      height: 28
+      spacing: 4
+
+      Text {
+        anchors.verticalCenter: parent.verticalCenter
+        text: root.pageState.ageLabel
+        color: "white"
+        opacity: 0.4
+        visible: text !== ""
+        font.family: Shell.Theme.plexFontFamily
+        font.pixelSize: 11
+      }
+      Shell.IconButton {
+        width: 26
+        height: 28
+        iconWidth: 16
+        iconHeight: 16
+        iconSource: Qt.resolvedUrl("assets/refresh.svg")
+        restingOpacity: root.pageState.running ? 0.35 : 0.6
+        accessibleName: "Refresh usage"
+        onClicked: root.pageState.refreshSoon(true)
+      }
+    }
+
+    Column {
+      id: body
+      x: 8
+      y: 64
+      width: Shell.PanelStyle.rowWidth
+      spacing: 0
+      visible: root.rowCount > 0 || root.waiting
+
+      Repeater {
+        model: root.waiting ? [] : root.rows
+        delegate: root.waiting ? skeletonDelegate : rowDelegate
+      }
+      Repeater {
+        visible: root.waiting
+        model: 3
+        delegate: skeletonDelegate
+      }
+    }
+
+    Text {
+      visible: !root.waiting && root.rowCount === 0
+      x: 20
+      y: 90
+      width: 276
+      text: root.pageState.lastError !== "" ? root.pageState.lastError : "No agent is signed in"
+      wrapMode: Text.Wrap
+      color: "white"
+      opacity: 0.5
+      font.family: Shell.Theme.fontFamily
+      font.pixelSize: 13
+    }
+
+    Text {
+      x: 20
+      y: 64 + root.listHeight + 2
+      width: 276
+      height: 16
+      visible: root.footerText !== ""
+      text: root.footerText
+      textFormat: Text.PlainText
+      elide: Text.ElideRight
+      color: root.pageState.failed ? root.palette.red : "white"
+      opacity: root.pageState.failed ? 1 : 0.4
+      font.family: Shell.Theme.fontFamily
+      font.pixelSize: 11
+    }
+  }
+
+  // One provider: mark, name, plan or account, and the headline number with a
+  // small window bar under it.
+  Component {
+    id: rowDelegate
+    Item {
+      id: line
+      required property int index
+      required property var modelData
+
+      readonly property var entry: line.modelData
+      readonly property var summary: Model.headline(line.entry)
+      readonly property var topRow: Model.tightestRow(line.entry)
+      readonly property bool failed: Model.isErrorOnly(line.entry)
+      readonly property string stateText: Model.stateText(line.entry)
+
+      width: Shell.PanelStyle.rowWidth
+      height: root.rowHeight
+
+      Rectangle {
+        anchors.fill: parent
+        anchors.topMargin: 1
+        anchors.bottomMargin: 1
+        radius: Shell.PanelStyle.rowRadius
+        color: rowPointer.hovered && root.interactive ? Shell.PanelStyle.hover : "transparent"
+        Behavior on color { ColorAnimation { duration: Shell.PanelStyle.controlDuration } }
+      }
+
+      ProviderIcon {
+        id: mark
+        provider: String(line.entry.provider || "")
+        size: 16
+        x: 12
+        anchors.verticalCenter: parent.verticalCenter
+        opacity: line.failed ? 0.4 : 1
+      }
+
+      Column {
+        id: labelBlock
+        x: 38
+        width: Math.max(0, parent.width - x - 84)
+        anchors.verticalCenter: parent.verticalCenter
+        spacing: 2
+
+        Text {
+          width: parent.width
+          text: Model.providerName(String(line.entry.provider || ""))
+          textFormat: Text.PlainText
+          elide: Text.ElideRight
+          color: "white"
+          opacity: line.failed ? 0.6 : 1
+          font.family: Shell.Theme.fontFamily
+          font.weight: Font.Medium
+          font.pixelSize: 15
+        }
+        Text {
+          width: parent.width
+          text: line.stateText !== ""
+              ? line.stateText + " · " + root.subtitle(line.entry)
+              : root.subtitle(line.entry)
+          textFormat: Text.PlainText
+          elide: Text.ElideRight
+          color: line.failed ? root.palette.red : "white"
+          opacity: line.failed ? 0.9 : 0.5
+          font.family: Shell.Theme.fontFamily
+          font.weight: Font.Normal
+          font.pixelSize: 12
+        }
+      }
+
+      Item {
+        id: value
+        visible: !line.failed
+        width: 64
+        x: parent.width - 12 - width
+        anchors.verticalCenter: parent.verticalCenter
+        height: 28
+
+        Text {
+          id: figure
+          anchors.top: parent.top
+          anchors.right: parent.right
+          text: line.summary ? line.summary.text : "—"
+          color: line.topRow ? Model.percentColor(line.topRow.percentLeft, root.palette) : "white"
+          font.family: Shell.Theme.plexFontFamily
+          font.pixelSize: 13
+        }
+        Rectangle {
+          visible: !!line.topRow
+          anchors.top: figure.bottom
+          anchors.right: parent.right
+          anchors.topMargin: 4
+          width: parent.width
+          height: 3
+          radius: 1.5
+          color: root.palette.track
+          Rectangle {
+            width: parent.width * Math.max(0, Math.min(100,
+                Number(line.topRow ? line.topRow.percentLeft : 0))) / 100
+            height: parent.height
+            radius: 1.5
+            color: Model.barColor(line.topRow, root.palette)
+          }
+        }
+      }
+
+      Text {
+        visible: line.failed
+        x: parent.width - 12 - width
+        anchors.verticalCenter: parent.verticalCenter
+        width: 64
+        horizontalAlignment: Text.AlignRight
+        text: "Error"
+        color: root.palette.red
+        font.family: Shell.Theme.plexFontFamily
+        font.pixelSize: 12
+      }
+
+      HoverHandler {
+        id: rowPointer
+        cursorShape: Qt.PointingHandCursor
+      }
+      TapHandler {
+        enabled: root.interactive && !line.failed
+        // openProvider is the drawer's function; a plain page (preview) gets
+        // only push, so fall back to pushing the provider page.
+        onTapped: {
+          if (root.stackController && root.stackController.openProvider)
+            root.stackController.openProvider(line.entry);
+          else if (root.stackController)
+            root.stackController.push("provider", { id: line.entry.id, provider: line.entry.provider });
+        }
+      }
+    }
+  }
+
+  Component {
+    id: skeletonDelegate
+    Item {
+      width: Shell.PanelStyle.rowWidth
+      height: root.rowHeight
+      Rectangle {
+        x: 12
+        anchors.verticalCenter: parent.verticalCenter
+        width: 16
+        height: 16
+        radius: 4
+        color: "white"
+        opacity: 0.08
+      }
+      Rectangle {
+        x: 38
+        y: 16
+        width: 96
+        height: 10
+        radius: 5
+        color: "white"
+        opacity: 0.08
+      }
+      Rectangle {
+        x: 38
+        y: 32
+        width: 60
+        height: 8
+        radius: 4
+        color: "white"
+        opacity: 0.06
+      }
+    }
+  }
+}
diff --git a/shell/codexbar/ProviderIcon.qml b/shell/codexbar/ProviderIcon.qml
new file mode 100644
index 0000000000000000000000000000000000000000..018fc7bdcede0553730caf53ef071dfa776e7065
--- /dev/null
+++ b/shell/codexbar/ProviderIcon.qml
@@ -0,0 +1,45 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import "CodexBarModel.mjs" as Model
+import ".." as Shell
+
+// Provider mark for a tile, a ring or a list row.
+//
+// QtQuick.Shapes and Canvas marks do not paint reliably inside this shell's
+// layered sidebar tree (probes, 2026-10-31); wide provider marks arrived as
+// slivers. A disc with the provider's tag fills no path and uses no canvas, so
+// it draws every time, gives every tile the same footprint, and carries the
+// provider colour that a logo would.
+Item {
+  id: root
+
+  required property string provider
+  property color color: "#FFFFFF"
+  property real size: 16
+  property real markOpacity: 1
+  // Disc colour behind the tag. Transparent leaves the card showing.
+  property color fill: "transparent"
+
+  readonly property string label: Model.tag(provider)
+
+  implicitWidth: size
+  implicitHeight: size
+  opacity: markOpacity
+
+  Rectangle {
+    anchors.fill: parent
+    radius: width / 2
+    color: root.fill
+  }
+
+  Text {
+    id: tag
+    anchors.centerIn: parent
+    text: root.label
+    color: root.color
+    font.pixelSize: Math.max(7, Math.round(root.size * (root.label.length > 1 ? 0.42 : 0.58)))
+    font.weight: Font.DemiBold
+    font.family: Shell.Theme.fontFamily
+  }
+}
diff --git a/shell/codexbar/ProviderPage.qml b/shell/codexbar/ProviderPage.qml
new file mode 100644
index 0000000000000000000000000000000000000000..bb9cb08e2be892ba8a4b8960d218fbe2a6ed4873
--- /dev/null
+++ b/shell/codexbar/ProviderPage.qml
@@ -0,0 +1,340 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import "CodexBarModel.mjs" as Model
+import "../" as Shell
+import "../" as Pond
+
+// Second drawer page: one provider in full.
+//
+// Bars per usage window, reset credits, spend, a 30-day spend strip, and the
+// account's status page. A provider that only reports spend (no windows) shows
+// the spend block alone with a note that limits are unavailable.
+Item {
+  id: root
+  // Named pageState: "state" is the base Item property.
+  required property var pageState
+  property var stackController
+  property bool interactive: true
+  property var selection: ({})
+
+  // Resolve by id on every change, so a refresh updates the open page in place.
+  readonly property var entry: {
+    const id = selection ? selection.id : "";
+    return pageState.entries.find(candidate => candidate.id === id) || null;
+  }
+  readonly property var providerRows: Model.rowsOf(entry)
+  readonly property var spend: Model.spendOf(entry)
+  readonly property var resets: Model.resetCreditsOf(entry)
+  readonly property var history: Model.historyBars(entry)
+  readonly property bool failed: Model.isErrorOnly(entry)
+  readonly property var theme: ({
+    ink: "#FFFFFF",
+    yellow: "#EBE075",
+    red: "#FA6D80",
+    track: "#303030"
+  })
+  readonly property real creditCount: Number(entry ? entry.creditsRemaining : NaN)
+  readonly property bool hasCredits: Number.isFinite(creditCount)
+  readonly property string siteUrl: Model.providerSite(entry)
+  readonly property string note: noteText()
+
+  readonly property real barsHeight: providerRows.reduce((sum, row) => sum + 42, 0)
+  readonly property real spendHeight: spend ? 74 : 0
+  readonly property real historyHeight: history.length > 0 ? 58 : 0
+  readonly property real resetsHeight: resets ? 30 : 0
+  readonly property real noteHeight: note !== "" ? 34 : 0
+  readonly property real footTop: 78 + barsHeight + resetsHeight + spendHeight
+      + historyHeight + noteHeight
+  readonly property real footHeight: 56
+
+  implicitWidth: Shell.PanelStyle.width
+  implicitHeight: footTop + footHeight
+
+  function noteText() {
+    if (!entry)
+      return "";
+    if (entry.error && !failed)
+      return String(entry.error.message || "Limits unavailable");
+    if (entry.usageUnavailable)
+      return "Limits unavailable. Spend below is local.";
+    if (entry.stale && entry.lastAttemptError)
+      return "Stale. Retrying: " + String(entry.lastAttemptError.message || "");
+    if (entry.stale)
+      return "Stale. Showing the last good reading.";
+    if (spend && spend.provenance === "listPriceEstimate")
+      return "Spend is a list-price estimate, not a bill.";
+    return "";
+  }
+
+  Pond.PanelBackground {
+    anchors.fill: parent
+
+    ProviderIcon {
+      id: mark
+      provider: root.entry ? root.entry.provider : String(root.selection.provider || "")
+      size: 20
+      x: 19.5
+      y: 20.5
+    }
+    Text {
+      id: title
+      x: mark.x + 20 + 8
+      y: 19.5
+      width: Math.max(0, 276 - mark.width - 8 - (back.visible ? back.width + 4 : 0))
+      text: Model.providerName(root.entry ? root.entry.provider : root.selection.provider)
+      textFormat: Text.PlainText
+      elide: Text.ElideRight
+      color: "white"
+      font.family: Shell.Theme.titleFontFamily
+      font.weight: Font.Normal
+      font.pixelSize: 20
+    }
+    Shell.IconButton {
+      id: back
+      x: 276 - width + 4
+      y: 19.5
+      width: 26
+      height: 28
+      iconWidth: 16
+      iconHeight: 16
+      iconSource: Qt.resolvedUrl("assets/back.svg")
+      restingOpacity: 0.6
+      accessibleName: "Back to providers"
+      onClicked: root.stackController.pop()
+    }
+    Text {
+      x: 20
+      y: 50
+      width: 276
+      text: root.subtitle()
+      textFormat: Text.PlainText
+      elide: Text.ElideRight
+      color: "white"
+      opacity: 0.5
+      font.family: Shell.Theme.fontFamily
+      font.pixelSize: 12
+    }
+
+    Column {
+      id: bars
+      x: 20
+      y: 78
+      width: 276
+      spacing: 13
+
+      Repeater {
+        model: root.providerRows
+        delegate: Bar {
+          required property var modelData
+          width: 276
+          wide: true
+          row: modelData
+          nowMs: root.pageState.nowMs
+        }
+      }
+    }
+
+    Text {
+      visible: !!root.resets
+      x: 20
+      y: 78 + root.barsHeight
+      width: 276
+      height: 24
+      text: root.resets ? root.resetsSummary() : ""
+      color: "white"
+      opacity: 0.7
+      font.family: Shell.Theme.fontFamily
+      font.pixelSize: 12
+    }
+
+    Column {
+      id: spendBlock
+      visible: !!root.spend
+      x: 20
+      y: 78 + root.barsHeight + root.resetsHeight
+      width: 276
+      spacing: 6
+
+      Row {
+        width: parent.width
+        Text {
+          width: parent.width / 2
+          text: root.spend && String(root.spend.sessionLabel || "") !== ""
+              ? String(root.spend.sessionLabel) : "Today"
+          color: "white"
+          opacity: 0.5
+          font.family: Shell.Theme.fontFamily
+          font.pixelSize: 11
+        }
+        Text {
+          width: parent.width / 2
+          text: root.spend && String(root.spend.last30DaysLabel || "") !== ""
+              ? String(root.spend.last30DaysLabel) : "30d"
+          color: "white"
+          opacity: 0.5
+          font.family: Shell.Theme.fontFamily
+          font.pixelSize: 11
+        }
+      }
+      Row {
+        width: parent.width
+        Text {
+          width: parent.width / 2
+          text: root.spend ? Model.money(root.spend.sessionCostUSD) : "—"
+          color: "white"
+          font.family: Shell.Theme.plexFontFamily
+          font.pixelSize: 15
+        }
+        Text {
+          width: parent.width / 2
+          text: root.spend ? Model.money(root.spend.last30DaysCostUSD) : "—"
+          color: "white"
+          opacity: 0.8
+          font.family: Shell.Theme.plexFontFamily
+          font.pixelSize: 15
+        }
+      }
+    }
+
+    // 30 daily spend bars; the last bar is today. Empty days stay as the
+    // track only, so the strip always shows the same 30 days.
+    Item {
+      id: historyStrip
+      visible: root.history.length > 0
+      x: 20
+      y: 78 + root.barsHeight + root.resetsHeight + root.spendHeight + 8
+      width: 276
+      height: 34
+
+      readonly property real slot: width / Math.max(1, root.history.length)
+
+      Repeater {
+        model: root.history
+        delegate: Item {
+          required property real modelData
+          required property int index
+          x: index * historyStrip.slot
+          y: 0
+          width: historyStrip.slot
+          height: historyStrip.height
+
+          Rectangle {
+            x: 1
+            width: Math.max(1, parent.width - 2)
+            height: parent.height
+            radius: 2
+            color: "white"
+            opacity: 0.05
+          }
+          Rectangle {
+            x: 1
+            width: Math.max(1, parent.width - 2)
+            height: Math.max(2, parent.height * modelData)
+            anchors.bottom: parent.bottom
+            radius: 2
+            color: "#4b929b"
+            opacity: 0.85
+          }
+        }
+      }
+    }
+
+    Text {
+      id: note
+      visible: root.noteHeight > 0
+      x: 20
+      y: 78 + root.barsHeight + root.resetsHeight + root.spendHeight
+          + root.historyHeight + 4
+      width: 276
+      height: 30
+      text: root.note
+      textFormat: Text.PlainText
+      wrapMode: Text.Wrap
+      maximumLineCount: 2
+      elide: Text.ElideRight
+      color: root.failed || root.entry && (root.entry.error || root.entry.usageUnavailable)
+          ? root.theme.red : "white"
+      opacity: 0.7
+      font.family: Shell.Theme.fontFamily
+      font.pixelSize: 11
+    }
+
+    Text {
+      visible: root.failed
+      x: 20
+      y: 78
+      width: 276
+      text: root.entry ? Model.errorText(root.entry, 220) : ""
+      textFormat: Text.PlainText
+      wrapMode: Text.Wrap
+      color: root.theme.red
+      font.family: Shell.Theme.fontFamily
+      font.pixelSize: 12
+    }
+
+    // Bottom row: reset credits (informational) and the one action that
+    // leaves the shell.
+    Row {
+      x: 20
+      y: root.footTop + 16
+      width: 276
+      height: 28
+
+      Text {
+        visible: root.entry !== null
+        anchors.verticalCenter: parent.verticalCenter
+        text: root.creditLine()
+        color: "white"
+        opacity: 0.6
+        font.family: Shell.Theme.fontFamily
+        font.pixelSize: 12
+      }
+
+      Shell.IconButton {
+        x: parent.width - width
+        width: 28
+        height: 28
+        iconWidth: 16
+        iconHeight: 16
+        iconSource: Qt.resolvedUrl("assets/open.svg")
+        restingOpacity: root.siteUrl !== "" ? 0.6 : 0.2
+        accessibleName: "Open usage page"
+        onClicked: if (root.interactive && root.siteUrl !== "") root.pageState.openSite(root.siteUrl)
+      }
+    }
+  }
+
+  function subtitle() {
+    if (!entry)
+      return "";
+    const parts = [];
+    if (entry.plan)
+      parts.push(String(entry.plan));
+    if (entry.account)
+      parts.push(String(entry.account));
+    if (entry.status && entry.status.description && entry.status.indicator !== "none")
+      parts.push(String(entry.status.description));
+    if (entry.stale)
+      parts.push("stale " + Model.ageText(entry.updatedAt, pageState.nowMs));
+    return parts.join(" · ");
+  }
+
+  function resetsSummary() {
+    const count = Math.round(Number(resets.availableCount));
+    const label = count === 1 ? "1 monthly limit reset left" : count + " monthly limit resets left";
+    const next = Date.parse(resets.nextExpiresAt || "");
+    if (!Number.isFinite(next))
+      return label;
+    const date = new Date(next).toLocaleDateString(Qt.locale().name, "MMM d");
+    return label + ", next expires " + date;
+  }
+
+  function creditLine() {
+    if (hasCredits)
+      return Model.compactNumber(creditCount) + " credits";
+    if (entry && entry.codeReviewRemainingPercent !== null && entry.codeReviewRemainingPercent !== undefined)
+      return "Code review " + Math.round(Number(entry.codeReviewRemainingPercent)) + "% left";
+    return "";
+  }
+}
diff --git a/shell/codexbar/README.md b/shell/codexbar/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..71e2c1c807106cf8f378e2326ad0ac73eb18b6ff
--- /dev/null
+++ b/shell/codexbar/README.md
@@ -0,0 +1,59 @@
+# CodexBar for Pond
+
+Usage for Codex, Claude, Antigravity, Grok and the other agents CodexBar
+tracks, drawn as a grid of provider tiles in the Pond sidebar.
+
+## Files
+
+| File | Role |
+|------|------|
+| `SidebarCard.qml` | The sidebar tile grid. Circles while expanded, a mini grid once the sidebar collapses. Click opens the drawer. |
+| `ExpandedView.qml` | The expanded card: one row per provider with its windows. |
+| `UsagePanel.qml` | The drawer: a `CardStack` like the Wi-Fi panel. |
+| `List.qml` | Drawer page 1: every provider, worst first. |
+| `ProviderPage.qml` | Drawer page 2: one provider in full. |
+| `Bar.qml` | One usage window: line bar, time-left tick, pace verdict. |
+| `Circle.qml` | One usage window as a ring. |
+| `ProviderIcon.qml` | Provider badge: two-letter tag in the provider colour. |
+| `State.qml` | Runs the helper, parses the snapshot, schedules refreshes. |
+| `CodexBarModel.mjs` | Pure presentation rules. Tested in `tests/model.test.mjs`. |
+| `codexbar-helper.mjs` | Vendored helper from the codexbar-plasmoid repo (fetch, cache, retries, cost scan). |
+
+## Settings
+
+`~/.config/codexbar-plasmoid/config.json`. Every key is optional.
+
+| Key | Default | Meaning |
+|-----|---------|---------|
+| `cliPath` | `""` | CodexBar CLI. `""` tries `~/.local/share/codexbar-plasmoid/bin/codexbar`, then `CODEXBAR_CLI`, then PATH. `~` expands. |
+| `autoUpdateCli` | `false` | Keep the managed CLI up to date. |
+| `provider` | `"all"` | One id, such as `"codex"`, asks only that provider. `"all"` uses `providers` or detection. |
+| `refreshIntervalSeconds` | `150` | Minimum 60. |
+| `cost` | `true` | Include the spend history scan. |
+| `credits` | `true` | Include credits. |
+| `anonymizeEmail` | `true` | Mask account emails. |
+| `timeoutSeconds` | `60` | Per-request CLI timeout, 5 to 120. |
+| `cardBars` | `4` | Rings in the collapsed sidebar, 1 to 6. |
+| `expanded` | `true` | Show the expanded card under the grid. |
+| `expandedRows` | `0` | Rows in the expanded card. 0 means one row per provider. |
+| `providers` | `[]` | Explicit provider ids to ask, for example `["codex", "claude"]`. Empty means Codex plus the agents detected on this machine. |
+
+The CLI runs only while the drawer is open. The card keeps the last good
+snapshot and shows how old it is.
+
+## Keyboard
+
+`Super+Shift+C` switches the drawer. The handler lives in the Sidebar, because
+the shell needs the sidebar's own state object.
+
+## Demo
+
+`CODEXBAR_POND_DEMO=1 qs -c pond-shell` draws `demo/snapshot.json` instead of
+running the CLI. `demo/gallery.json` is a real snapshot from this machine on
+2026-10-29, for checking tile rendering without a fetch.
+
+## Tests
+
+```sh
+node ~/.config/quickshell/pond-shell/codexbar/tests/model.test.mjs
+```
diff --git a/shell/codexbar/Ring.qml b/shell/codexbar/Ring.qml
new file mode 100644
index 0000000000000000000000000000000000000000..501d05ff98aaef950d74d779c6773b70eeaa9c1c
--- /dev/null
+++ b/shell/codexbar/Ring.qml
@@ -0,0 +1,73 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+
+// One circular usage gauge.
+//
+// The arc fills clockwise from 12 o'clock to `value` percent, over a faint
+// track. A thin tick at `timeLeft` shows how much of the window is left, so an
+// arc that reaches past the tick means the budget outlasts the clock. Both
+// colours come from the caller; the model decides them.
+//
+// Drawn on a Canvas. Stroked QtQuick.Shapes arcs and Qt Canvas arcs both paint
+// unreliably inside the sidebar's layer tree in this Quickshell build
+// (2026-10-31), so the ring is built from primitives the scene graph draws
+// every time: a rounded rectangle per segment, rotated around the centre.
+Item {
+  id: root
+
+  required property real value
+  property color color: "#FFFFFF"
+  property color trackColor: "#3A3A3A"
+  // 0..1 of the window still ahead, or -1 to hide the tick.
+  property real timeLeft: -1
+  property real stroke: 4
+  readonly property real percent: Math.max(0, Math.min(100, Number(value) || 0))
+  readonly property real size: Math.min(width, height)
+  readonly property real center: size / 2
+  readonly property real radius: Math.max(1, (size - stroke) / 2)
+  // Degree covered by one dash, thick enough to overlap its neighbours.
+  readonly property int dashWidth: Math.max(3, Math.ceil(size / 6))
+  readonly property int dashCount: Math.max(8, Math.floor(Math.PI * 2 * radius / (dashWidth * 0.8)))
+  readonly property int litDashes: Math.round(dashCount * percent / 100)
+
+  implicitWidth: 36
+  implicitHeight: 36
+
+  Repeater {
+    model: root.dashCount
+    delegate: Rectangle {
+      required property int index
+      width: root.dashWidth
+      height: root.stroke
+      radius: height / 2
+      antialiasing: true
+      color: index < root.litDashes ? root.color : root.trackColor
+      // Every dash starts at the top centre and turns to its place on the dial.
+      x: root.center - width / 2
+      y: 0
+      transform: Rotation {
+        origin.x: width / 2
+        origin.y: root.center
+        angle: 360 * index / root.dashCount
+      }
+    }
+  }
+
+  // The tick sits at the time-left angle, one degree per percent from the top.
+  Item {
+    id: wheel
+    anchors.fill: parent
+    visible: root.timeLeft >= 0
+    rotation: 360 * Math.max(0, Math.min(1, root.timeLeft))
+    Rectangle {
+      width: 1.5
+      height: root.stroke + 3
+      radius: 0.75
+      x: wheel.width / 2 - width / 2
+      y: -1.5
+      color: "#FFFFFF"
+      opacity: 0.7
+    }
+  }
+}
diff --git a/shell/codexbar/SidebarCard.qml b/shell/codexbar/SidebarCard.qml
new file mode 100644
index 0000000000000000000000000000000000000000..ac6cd0ef2d8991aaa640ec1e9015b1ca61168105
--- /dev/null
+++ b/shell/codexbar/SidebarCard.qml
@@ -0,0 +1,213 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import "CodexBarModel.mjs" as Model
+import ".." as Shell
+
+// CodexBar in the sidebar.
+//
+// The card has two rest states. Expanded, it is a header, a grid of provider
+// tiles with one ring per usage window, and, when enabled, a row list with
+// the numbers. Compact, it shrinks to one column of mark and ring per
+// provider, so the 48 px rail still answers which agent is tightest.
+//
+// Clicking a tile or a row opens that provider in the drawer. The header's
+// chevron folds the expanded card without touching the rest of the sidebar.
+// The card keeps the last snapshot; it never blanks on a failed refresh.
+Shell.Card {
+  id: root
+
+  required property var state
+  property real collapseProgress: 0
+  property bool panelOpen: false
+  // User fold for the expanded state, kept by the sidebar.
+  property bool expandedView: true
+  property int cardBars: 3
+  property int expandedRows: 0
+  signal tileClicked(var entry)
+  signal foldToggled
+
+  readonly property real widthProgress: Shell.Theme.collapseWidth(collapseProgress)
+  readonly property real heightProgress: Shell.Theme.collapseHeight(collapseProgress)
+  readonly property bool compact: collapseProgress >= 0.56
+  readonly property bool loaded: state.loaded && (state.entries || []).length > 0
+  readonly property var entries: state.ordered || []
+  readonly property int liveCount: entries.filter(entry => !Model.isErrorOnly(entry)).length
+  readonly property string ageText: state.generatedAt === "" ? "" : Model.ageText(state.generatedAt, state.nowMs)
+  readonly property var theme: ({
+    ink: Shell.Theme.daylight ? "#FFFFFF" : Shell.Theme.sidebarV3Foreground,
+    yellow: "#EBE075",
+    red: "#FA6D80",
+    track: Shell.Theme.daylight ? Qt.rgba(1, 1, 1, 0.14) : "#2B2B2B"
+  })
+  readonly property int padding: 8
+  readonly property int headerHeight: 30
+  readonly property int footerHeight: 24
+  readonly property int rowsShown: expandedRows > 0
+      ? Math.min(expandedRows, entries.length) : entries.length
+  // The row list lives in the expanded state only.
+  readonly property bool showRows: !compact && expandedView && loaded && rowsShown > 0
+
+  // Resting heights. The grid measures itself; both states are exact, so the
+  // card never drifts a few pixels per snapshot.
+  readonly property int gridExpandedHeight: gallery.implicitHeight
+  readonly property int gridCompactHeight: gallery.compactHeight
+  readonly property int expandedHeight: padding + headerHeight + gridExpandedHeight
+      + (showRows ? 6 + rowsShown * 30 : 0) + (loaded ? footerHeight : 0)
+  readonly property int compactHeight: gridCompactHeight + (loaded ? footerHeight : 0)
+
+  height: Shell.Theme.lerp(expandedHeight, compactHeight, heightProgress)
+  implicitHeight: height
+  radius: Shell.Theme.lerp(12, Shell.Theme.sidebarCardRadius, widthProgress)
+  classicColor: cardHover.hovered || panelOpen ? Shell.Theme.mediaHoverBackground
+      : Shell.Theme.sidebarV3Background
+  animateClassicColor: true
+  clip: true
+
+  // Folding re-measures the card; the sidebar does not animate its own stack.
+  Behavior on height {
+    enabled: root.collapseProgress === 0 || root.collapseProgress === 1
+    Shell.Motion { duration: 200 }
+  }
+
+  HoverHandler { id: cardHover }
+
+  // Canvases paint on the first frame only with a root layer: this card has
+  // several, and the sidebar blends the card into a blurred scene.
+  readonly property bool hasRings: loaded && !compact
+  layer.enabled: false
+
+
+  // Header: title, live count, fold chevron.
+  Item {
+    id: header
+    x: 0
+    y: root.compact ? 0 : root.padding
+    width: parent.width
+    height: root.headerHeight
+    opacity: root.compact ? 0 : 1
+
+    Text {
+      x: root.padding + 8
+      anchors.verticalCenter: parent.verticalCenter
+      text: "CodexBar"
+      color: root.theme.ink
+      font.family: Shell.Theme.titleFontFamily
+      font.pixelSize: 15
+    }
+
+    Text {
+      id: counter
+      anchors.right: chevron.visible ? chevron.left : parent.right
+      anchors.rightMargin: chevron.visible ? 2 : root.padding + 8
+      anchors.verticalCenter: parent.verticalCenter
+      text: root.state.running ? "…" : root.liveCount + "/" + root.entries.length
+      color: root.theme.ink
+      opacity: 0.4
+      font.family: Shell.Theme.plexFontFamily
+      font.pixelSize: 9
+    }
+
+    Shell.IconButton {
+      id: chevron
+      anchors.right: parent.right
+      anchors.rightMargin: 2
+      width: 26
+      height: 26
+      anchors.verticalCenter: parent.verticalCenter
+      iconWidth: 12
+      iconHeight: 12
+      iconSource: Qt.resolvedUrl(root.expandedView
+          ? "assets/chevron-up.svg" : "assets/chevron-down.svg")
+      restingOpacity: 0.55
+      accessibleName: root.expandedView ? "Hide provider rows" : "Show provider rows"
+      visible: root.loaded && rowsShown > 0 && !root.compact
+      onClicked: root.foldToggled()
+    }
+  }
+
+  Gallery {
+    id: gallery
+    y: root.compact ? 0 : root.padding + root.headerHeight
+    width: parent.width
+    state: root.state
+    collapseProgress: root.collapseProgress
+    theme: root.theme
+    bars: root.cardBars
+    maxTiles: root.cardBars > 3 ? 4 : 5
+    onTileClicked: entry => root.tileClicked(entry)
+  }
+
+  ExpandedView {
+    id: rowList
+    visible: root.showRows
+    x: root.padding + 4
+    width: parent.width - (root.padding + 4) * 2
+    y: root.padding + root.headerHeight + root.gridExpandedHeight + 4
+    state: root.state
+    theme: root.theme
+    bars: root.cardBars
+    maxRows: root.rowsShown
+    onRowClicked: entry => root.tileClicked(entry)
+  }
+
+  // Footer: age of the snapshot, retry state, spend total.
+  Item {
+    id: footer
+    visible: root.loaded && !root.compact
+    width: parent.width
+    height: root.footerHeight
+    y: root.expandedHeight - root.footerHeight
+
+    Rectangle {
+      x: root.padding + 8
+      anchors.verticalCenter: parent.verticalCenter
+      width: status.width + 10
+      height: 15
+      radius: 7.5
+      color: Shell.Theme.daylight ? Qt.rgba(1, 1, 1, 0.06) : "#262626"
+      Text {
+        id: status
+        anchors.centerIn: parent
+        text: root.state.running ? "refreshing"
+            : root.state.failed && root.state.entries.length > 0 ? "stale"
+            : root.ageText + " ago"
+        color: root.state.failed ? root.theme.red : root.theme.ink
+        opacity: root.state.failed ? 1 : 0.45
+        font.family: Shell.Theme.plexFontFamily
+        font.pixelSize: 9
+      }
+    }
+
+    Text {
+      anchors.right: parent.right
+      anchors.rightMargin: root.padding + 15
+      anchors.verticalCenter: parent.verticalCenter
+      text: Model.money(root.state.totalSpend)
+      color: root.theme.ink
+      opacity: 0.5
+      font.family: Shell.Theme.plexFontFamily
+      font.pixelSize: 9
+    }
+  }
+
+  // A snapshot that arrived but holds nothing worth drawing.
+  Text {
+    visible: root.state.loaded && (root.state.entries || []).length === 0
+    x: root.padding + 8
+    y: root.compact ? (parent.height - height) / 2 : root.headerHeight + root.padding
+    text: root.state.failed ? "No usage" : "Nothing installed"
+    color: root.theme.ink
+    opacity: 0.45
+    font.family: Shell.Theme.fontFamily
+    font.pixelSize: 11
+  }
+
+  TapHandler {
+    acceptedButtons: Qt.LeftButton
+    // The card body opens the drawer; tiles, rows, chevron and footer sit
+    // above it and take their own presses.
+    gesturePolicy: TapHandler.ReleaseWithinBounds
+    onTapped: root.tileClicked(null)
+  }
+}
diff --git a/shell/codexbar/State.qml b/shell/codexbar/State.qml
new file mode 100644
index 0000000000000000000000000000000000000000..5f031c569993de44f4c15f42edcbbc2db5339534
--- /dev/null
+++ b/shell/codexbar/State.qml
@@ -0,0 +1,477 @@
+import QtQuick
+import QtCore
+import Quickshell
+import Quickshell.Io
+import "CodexBarModel.mjs" as Model
+
+// CodexBar usage state for the Pond sidebar.
+//
+// The vendored helper (codexbar-helper.mjs) does the fetching, caching, retries,
+// and cost scanning. This singleton only runs it, keeps the last good snapshot,
+// and shows how old that snapshot is. A failed run never clears the screen: the
+// previous entries stay until a run succeeds.
+//
+// Settings live in ~/.config/codexbar-plasmoid/config.json:
+//   { "cliPath": "...", "autoUpdateCli": false, "provider": "all",
+//     "refreshIntervalSeconds": 150, "cost": true, "credits": true,
+//     "anonymizeEmail": true }
+// Missing keys use the defaults below, which match the KDE plasmoid.
+//
+// This is a plain component, not a singleton: a singleton declared inside a
+// plain directory is opaque to QML property and signal access in this
+// Quickshell build, so only its own methods would work. The Sidebar creates
+// the one instance and passes it to the card and the panel.
+Item {
+  id: root
+
+  // Until the first run finishes, the widget shows its skeleton.
+  property bool loaded: false
+  property bool running: false
+  property bool failed: false
+  property string lastError: ""
+  // Top-level cost scan complaint. Cost is optional, so this is a note only.
+  property string costNote: ""
+  property string generatedAt: ""
+  // Entries from the last successful run, unranked. Read through ordered().
+  property var entries: []
+  property int nowMs: Date.now()
+
+  // Set while the panel is on screen. The CLI and its cost scan run only then,
+  // so a closed widget costs nothing.
+  property bool wanted: false
+
+  // The module-imported singleton (shell.qml, Sidebar.qml) only exposes this
+  // instance's methods in this build, so the sidebar and shell talk to it
+  // through signals, which cross that boundary.
+  //   refreshRequested - re-run the CLI now (an IPC or keybind action).
+  //   (wanted, set by the panel's open state, is a plain property and also
+  //    reads correctly from the sidebar.)
+  signal refreshRequested
+
+  // Last thing the IPC path needs to do to the state. The shell reaches the
+  // sidebar's own instance through this reference, because a second import of
+  // the file in shell.qml would create a different, empty object.
+  property var settings: ({})
+  readonly property var cliPath: String(settings.cliPath || "")
+  readonly property bool autoUpdate: settings.autoUpdateCli === true
+  readonly property string provider: String(settings.provider || "all")
+  readonly property int refreshSeconds: Math.max(60, Number(settings.refreshIntervalSeconds) || 150)
+  readonly property bool includeCost: settings.cost !== false
+  readonly property bool includeCredits: settings.credits !== false
+  readonly property bool anonymizeEmail: settings.anonymizeEmail !== false
+  readonly property int timeoutSeconds: Math.max(5, Math.min(120, Number(settings.timeoutSeconds) || 60))
+  // Rings per provider tile, 1 to 6.
+  readonly property int cardBars: Math.max(1, Math.min(6, Number(settings.cardBars) || 3))
+  // Rows under the grid in the expanded card. 0 means one row per provider.
+  readonly property int expandedRows: Math.max(0, Math.min(8, Number(settings.expandedRows) || 0))
+  readonly property bool expandedCard: settings.expanded !== false
+
+  // The path may hold "~" or "$HOME"; the helper spawns binaries itself, so a
+  // relative name would resolve against the shell process directory.
+  readonly property string home: Quickshell.env("HOME") || ""
+  readonly property string resolvedCliPath: resolveCliPath(cliPath)
+
+  readonly property string helperPath: localPath(Qt.resolvedUrl("codexbar-helper.mjs"))
+  readonly property string settingsPath: localPath(Qt.resolvedUrl("../../codexbar-plasmoid/config.json"))
+  // Sample snapshots: demo (7 providers, errors) and gallery (a real 5-provider
+  // snapshot with two-window providers and credits).
+  property url fixturePath: Qt.resolvedUrl("demo/snapshot.json")
+
+  // Ranked worst first. Kept as one value so Repeaters see one change per run.
+  readonly property var ordered: Model.rank(entries)
+  readonly property var leadEntry: Model.lead(entries)
+  readonly property string leadLabel: Model.compactLabel(leadEntry)
+  readonly property string ageLabel: generatedAt === "" ? "" : Model.ageText(generatedAt, nowMs)
+  readonly property real totalSpend: Model.totalSpend(entries)
+
+  // Drop the cached snapshot so the next run asks the CLI again.
+  function options(force) {
+    return {
+      force: force === true,
+      cost: includeCost,
+      credits: includeCredits,
+      anonymize: anonymizeEmail,
+      autoUpdate,
+      provider,
+    };
+  }
+
+  function command(options) {
+    const args = [
+      "node", helperPath,
+      "--provider", options.provider,
+      "--timeout", String(root.timeoutSeconds),
+      "--cost", options.cost ? "true" : "false",
+      "--credits", options.credits ? "true" : "false",
+      "--anonymize-emails", options.anonymize ? "true" : "false",
+      "--auto-update", options.autoUpdate ? "true" : "false",
+      "--cache-seconds", String(root.refreshSeconds),
+      "--cost-cache-seconds", "3600",
+      "--force", options.force ? "true" : "false",
+    ];
+    if (root.resolvedCliPath !== "") {
+      args.push("--cli", root.resolvedCliPath);
+    }
+    if (root.provider === "all") {
+      args.push("--providers", JSON.stringify(root.providerConfigs()));
+    }
+    return args;
+  }
+
+  // Providers to ask for. CodexBar's own auto-discovery guesses a dozen agents
+  // from bare home directories (Augment, Factory, Kiro and others appear from
+  // half-hidden caches and only ever fail), so the list is explicit:
+  //  - `settings.providers` names them, when set;
+  //  - otherwise Codex always, plus the agents this shell can see signed in.
+  // A provider that fails anyway stays in the drawer (its error is real, for
+  // example an expired cursor session), but it never reaches the grid.
+  function providerConfigs() {
+    if (Array.isArray(settings.providers) && settings.providers.length > 0) {
+      return settings.providers.map(id => ({ provider: String(id), source: "auto" }));
+    }
+    if (provider !== "all") {
+      return [{ provider: provider, source: "auto" }];
+    }
+    return detectedProviders().map(id => ({ provider: id, source: "auto" }));
+  }
+
+  // Agents and the profile directories that mean "signed in here". Every path
+  // is checked, so a provider is detected by any of its plausible spots.
+  readonly property var agentProfiles: {
+    const home = root.home;
+    const config = Quickshell.env("XDG_CONFIG_HOME") || home + "/.config";
+    return [
+      { id: "codex", paths: [home + "/.codex"] },
+      { id: "claude", paths: [home + "/.claude"] },
+      { id: "antigravity", paths: [home + "/.antigravity"] },
+      { id: "grok", paths: [home + "/.grok"] },
+      { id: "cursor", paths: [config + "/Cursor", home + "/.cursor"] },
+      // opencode and opencodego share one profile; asking both doubles the
+      // fetch for the same console session.
+      { id: "opencode", paths: [config + "/opencode", home + "/.local/share/opencode"] },
+      { id: "commandcode", paths: [home + "/.commandcode"] },
+      { id: "codebuddy", paths: [home + "/.codebuddy", home + "/.local/share/CodeBuddyExtension"] },
+    ];
+  }
+
+  readonly property var profilePaths: {
+    const list = [];
+    for (const agent of agentProfiles)
+      for (const path of agent.paths)
+        if (list.indexOf(path) < 0) list.push(path);
+    return list;
+  }
+
+  // Agents with a signed-in profile here, in a stable order. Codex is always
+  // asked: it is the account the widget exists for. The first run may start
+  // before the probes finish, which only means fewer agents that once.
+  function detectedProviders() {
+    const found = agentProfiles
+        .filter(agent => agent.paths.some(path => root.pathExists(path)))
+        .map(agent => agent.id);
+    return found.indexOf("codex") >= 0 ? found : ["codex"].concat(found);
+  }
+
+  // Which agents have a profile here. A probe FileView per path, built once
+  // and destroyed after it reports; a directory opens with an empty read,
+  // which FileView.loads reports as a failure.
+  property var probeResults: ({})
+  property var probeQueue: []
+  property bool probing: false
+
+  function pathExists(path) {
+    return probeResults[path] === true;
+  }
+
+  function probePaths(paths) {
+    const pending = [];
+    for (const path of paths) {
+      if (!(path in probeResults))
+        pending.push(path);
+    }
+    if (pending.length === 0)
+      return;
+    for (const path of pending) {
+      probeResults[path] = false;
+      probeQueue.push(path);
+    }
+    probeResults = Object.assign({}, probeResults);
+    if (!probing) {
+      probing = true;
+      Qt.callLater(root.runProbe);
+    }
+  }
+
+  function runProbe() {
+    if (probeQueue.length === 0) {
+      probing = false;
+      return;
+    }
+    const path = probeQueue.shift();
+    const view = pathProbe.createObject(root, { path: path });
+    view.probed.connect(ok => {
+      probeResults[path] = ok;
+      probeResults = Object.assign({}, probeResults);
+      view.destroy();
+      Qt.callLater(root.runProbe);
+      // The first run may have started without this profile.
+      if (ok && root.wanted && !root.running && root.failures === 0)
+        root.refresh(false);
+    });
+    view.reload();
+  }
+
+  // FileView reports both ends of a load: a directory or a missing path lands
+  // in loadFailed, a readable file in loaded.
+  readonly property Component pathProbe: Component {
+    FileView {
+      signal probed(bool ok)
+      printErrors: false
+      onLoaded: probed(true)
+      onLoadFailed: probed(false)
+    }
+  }
+
+  function resolveCliPath(path) {
+    const value = String(path || "").trim();
+    if (value === "") {
+      return "";
+    }
+    if (value === "~" || value.startsWith("~/")) {
+      return root.home + value.slice(1);
+    }
+    return value;
+  }
+
+  function localPath(url) {
+    return decodeURIComponent(String(url).replace(/^file:\/\//, ""));
+  }
+
+  onRefreshRequested: root.refreshSoon(true)
+
+  // DIAGNOSTIC: what the card is being asked for.
+  onEntriesChanged: console.warn("STATE n=" + entries.length + " ids="
+      + entries.map(e => e.provider).join(","))
+  // Called every time the panel opens. The first open starts a refresh; a
+  // later open picks up whatever the background schedule has chosen.
+  function noteDemand() {
+    if (failures >= 3) {
+      failures = 0;
+    }
+    if (!running && !restartDelay.running) {
+      refresh(false);
+    }
+  }
+
+  // A manual refresh always goes to the CLI and restarts the failure backoff.
+  function refresh(force) {
+    failures = 0;
+    restartDelay.stop();
+    start(options(force === true));
+  }
+
+  // A manual refresh during a run asks for one more run afterwards.
+  function refreshSoon(force) {
+    restartDelay.stop();
+    restartDelay.interval = 0;
+    request = options(force === true);
+    restartDelay.restart();
+  }
+
+  function start(runOptions) {
+    if (proc.running) {
+      // A forced run must not wait for the one in flight.
+      pending = runOptions;
+      proc.running = false;
+      return;
+    }
+    request = runOptions;
+    proc.command = command(runOptions);
+    running = true;
+    proc.running = true;
+  }
+
+  function accept(text) {
+    const trimmed = String(text || "").trim();
+    if (trimmed === "") {
+      return "CodexBar returned no data";
+    }
+    let parsed;
+    try {
+      parsed = JSON.parse(trimmed);
+    } catch (error) {
+      return "CodexBar sent unreadable data: " + trimmed.slice(0, 120);
+    }
+    if (!parsed || typeof parsed !== "object") {
+      return "CodexBar sent unreadable data";
+    }
+    if (parsed.ok === false) {
+      return String(parsed.error || "CodexBar could not run");
+    }
+    if (!Array.isArray(parsed.entries)) {
+      return "CodexBar sent no provider list";
+    }
+    entries = parsed.entries;
+    generatedAt = String(parsed.generatedAt || "");
+    costNote = String(parsed.costError || "");
+    loaded = true;
+    return "";
+  }
+
+  function finish(errorText) {
+    running = false;
+    failed = errorText !== "";
+    lastError = errorText;
+    if (errorText === "" || entries.length > 0) {
+      failures = 0;
+    } else {
+      failures += 1;
+    }
+    // Keep the last good snapshot on screen; only the footer reports failure.
+    scheduleRefresh();
+    if (pending !== null) {
+      const next = pending;
+      pending = null;
+      if (next.force) {
+        start(next);
+      }
+    }
+  }
+
+  function scheduleRefresh() {
+    // Stopped processes still schedule; work runs only with panel demand.
+    if (!wanted) {
+      return;
+    }
+    restartDelay.stop();
+    if (failures > 0) {
+      const wait = Math.min(1800, 60 * Math.pow(2, failures - 1));
+      restartDelay.interval = wait * 1000;
+    } else {
+      restartDelay.interval = refreshSeconds * 1000;
+    }
+    restartDelay.restart();
+  }
+
+  // Provider pages open in the user's browser: CodexBar has no in-app view.
+  function openSite(url) {
+    if (!/^https?:\/\//.test(String(url || ""))) {
+      return;
+    }
+    Quickshell.execDetached(["xdg-open", url]);
+  }
+
+  // A failed forced refresh keeps retrying; background runs stay quiet.
+  property int failures: 0
+  // Options of the last run; a failed forced run retries on the backoff.
+  property var request: ({})
+  property string stdoutBuffer: ""
+  property bool killed: false
+  property var pending: null
+
+  onWantedChanged: scheduleRefresh()
+
+  Component.onCompleted: {
+    // Probe the usual agent profiles once, so the first run can ask for the
+    // agents that exist and spin up one CLI process instead of a dozen.
+    root.probePaths(root.profilePaths);
+    // CODEXBAR_POND_DEMO=1 draws the bundled sample snapshot instead of running
+    // the CLI, for screenshots and UI work without accounts.
+    if (Quickshell.env("CODEXBAR_POND_GALLERY") === "1") {
+      fixturePath = Qt.resolvedUrl("demo/gallery.json");
+      fixtureRead.reload();
+    } else if (Quickshell.env("CODEXBAR_POND_DEMO") === "1") {
+      fixtureRead.reload();
+    }
+  }
+
+  Timer {
+    interval: 30000
+    repeat: true
+    running: root.loaded
+    onTriggered: root.nowMs = Date.now()
+  }
+
+  Timer {
+    id: restartDelay
+    repeat: false
+    onTriggered: {
+      if (root.failures > 0 && root.request.force)
+        root.start(root.options(true));
+      else if (root.wanted)
+        root.start(root.options(false));
+    }
+  }
+
+  // A run that outlives its own timeout is stuck; kill it and report.
+  Timer {
+    id: watchdog
+    interval: (root.timeoutSeconds + 90) * 1000
+    running: root.running
+    onTriggered: {
+      if (!root.running) {
+        return;
+      }
+      root.killed = true;
+      proc.running = false;
+      root.finish("CodexBar did not answer in time");
+    }
+  }
+
+  // A missing or broken settings file keeps the defaults; the widget reacts by
+  // reloading settings when the file is edited.
+  FileView {
+    id: settingsFile
+    path: root.settingsPath
+    watchChanges: true
+    printErrors: false
+    onLoaded: {
+      try {
+        const parsed = JSON.parse(text());
+        root.settings = parsed && typeof parsed === "object" ? parsed : ({});
+      } catch (error) {
+        root.settings = ({});
+      }
+    }
+    onFileChanged: reload()
+  }
+
+  // Sample snapshot for CODEXBAR_POND_DEMO=1.
+  FileView {
+    id: fixtureRead
+    path: root.fixturePath
+    printErrors: false
+    onLoaded: {
+      const error = root.accept(text());
+      root.generatedAt = new Date().toISOString();
+      root.loaded = true;
+      if (error !== "") {
+        root.failures = 1;
+      }
+      root.failed = error !== "";
+      root.lastError = error;
+    }
+  }
+
+  Process {
+    id: proc
+    environment: ({ "LC_ALL": "C" })
+    onStarted: root.killed = false
+    onExited: (exitCode, exitStatus) => {
+      watchdog.stop();
+      if (root.killed) {
+        root.killed = false;
+        return;
+      }
+      let errorText = root.accept(root.stdoutBuffer);
+      root.stdoutBuffer = "";
+      if (errorText === "" && exitCode !== 0) {
+        errorText = "CodexBar stopped with exit code " + exitCode;
+      }
+      root.finish(errorText);
+    }
+    stdout: StdioCollector {
+      onStreamFinished: root.stdoutBuffer = text
+    }
+  }
+}
diff --git a/shell/codexbar/Tile.qml b/shell/codexbar/Tile.qml
new file mode 100644
index 0000000000000000000000000000000000000000..252ccd1672bff6117189b7b8529643d2251e32fc
--- /dev/null
+++ b/shell/codexbar/Tile.qml
@@ -0,0 +1,135 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import "CodexBarModel.mjs" as Model
+import ".." as Shell
+
+// One provider in the grid: mark, rings, short name.
+//
+// Expanded tiles carry the mark on top, a row of rings, and the short name
+// under them. Compact tiles are mark plus one ring on a single row. A failed
+// provider keeps its mark dim, an empty ring and a red dot, so the tile says
+// "broken" without a sentence.
+//
+// Child positions are arithmetic. Anchors and implicit widths depend on a
+// parent that is still being laid out, and resolve to zero in this shell.
+Item {
+  id: root
+
+  required property var tile
+  required property bool compact
+  required property var theme
+  // Wall clock, shared by every tile so rings tick together.
+  required property real nowMs
+  // Channel back to the card when this tile has drawn its rings, so the card
+  // can refresh a root-level capture of the animated canvas.
+  signal ringsPainted
+  signal clicked
+
+  readonly property bool ready: tile !== undefined && tile !== null
+  readonly property var entry: ready ? tile.entry : null
+  readonly property var rings: ready ? tile.rings : []
+  readonly property bool failed: ready && tile.error === true
+  readonly property string provider: ready ? String(entry.provider || "") : ""
+  readonly property string name: ready ? Model.shortName(entry.provider) : ""
+  readonly property var tightestRow: ready ? Model.tightestRow(entry) : null
+  readonly property color markColor: !ready ? theme.track
+      : failed ? theme.red : Model.ringColor(entry, tightestRow, theme)
+  readonly property real ringSize: compact ? 16 : 22
+  readonly property real markSize: compact ? 14 : 15
+  readonly property int ringStroke: compact ? 2 : 2.5
+
+  Accessible.role: Accessible.Button
+  Accessible.name: ready ? Model.accessibleLabel(tile) : "CodexBar"
+  Accessible.onPressAction: root.clicked()
+  visible: root.ready
+
+  Rectangle {
+    anchors.fill: parent
+    radius: Shell.PanelStyle.rowRadius
+    color: pointer.hovered ? Shell.Theme.sidebarHoverFill : "transparent"
+    Behavior on color { Shell.HoverAnimation {} }
+  }
+
+  HoverHandler {
+    id: pointer
+    cursorShape: Qt.PointingHandCursor
+  }
+  TapHandler {
+    onTapped: root.clicked()
+  }
+
+  // The mark. Compact tiles put it on the left of a single row.
+  ProviderIcon {
+    id: mark
+    provider: root.provider
+    color: root.markColor
+    size: root.markSize
+    markOpacity: root.failed ? 0.5 : 1
+    x: root.compact ? 7 : Math.round((root.width - width) / 2)
+    y: root.compact ? Math.round((root.height - height) / 2) : 6
+  }
+
+  // The rings: every window expanded, the tightest one compact.
+  Row {
+    id: ringRow
+    x: root.compact
+        ? mark.x + mark.width + 2
+        : Math.round((root.width - Math.min(root.width, 3 * root.ringSize + 4)) / 2)
+    y: root.compact ? Math.round((root.height - root.ringSize) / 2) : 6 + mark.height + 5
+    spacing: 2
+
+    Repeater {
+      model: root.compact ? root.rings.slice(0, 1) : root.rings
+      delegate: Ring {
+        required property var modelData
+        width: root.ringSize
+        height: root.ringSize
+        stroke: root.ringStroke
+        value: modelData.value
+        // Each ring carries the colour of its own window.
+        color: Model.ringColor(root.entry, modelData.row, root.theme)
+        trackColor: root.theme.track
+        timeLeft: modelData.row ? Model.windowLeft(modelData.row, root.nowMs) : -1
+      }
+    }
+
+    // No usage at all: one empty ring keeps the cell reading as a gauge.
+    Ring {
+      visible: root.rings.length === 0
+      width: root.ringSize
+      height: root.ringSize
+      stroke: root.ringStroke
+      value: 0
+      color: root.theme.track
+      trackColor: root.theme.track
+    }
+  }
+
+  // The name, expanded only: two rows of tile leave no space for it below.
+  Text {
+    visible: !root.compact
+    x: 2
+    width: root.width - 4
+    y: ringRow.y + ringRow.height + 4
+    horizontalAlignment: Text.AlignHCenter
+    text: root.name
+    color: root.theme.ink
+    opacity: root.failed ? 0.45 : 0.72
+    font.family: Shell.Theme.fontFamily
+    font.pixelSize: 10
+    font.weight: Font.Medium
+    elide: Text.ElideRight
+  }
+
+  // A failed provider keeps a red dot beside its name.
+  Rectangle {
+    visible: root.failed
+    width: 5
+    height: 5
+    radius: 2.5
+    color: root.theme.red
+    x: root.compact ? root.width - 8 : Math.round(root.width / 2 + 14)
+    y: root.compact ? 5 : ringRow.y + ringRow.height + 3
+  }
+}
diff --git a/shell/codexbar/UsagePanel.qml b/shell/codexbar/UsagePanel.qml
new file mode 100644
index 0000000000000000000000000000000000000000..0de4dce9fede6e627ac93fb6e2f83cefdd39be38
--- /dev/null
+++ b/shell/codexbar/UsagePanel.qml
@@ -0,0 +1,88 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import "../" as Pond
+import "../" as Pond
+
+// CodexBar usage drawer.
+//
+// `state` is required: the sidebar owns the only instance and passes it down.
+//
+// Same card stack as the Wi-Fi panel: 316 px pages, a 20 px close-button
+// gutter, push and pop transitions. The first page lists every provider, worst
+// first. Picking a row pushes the provider page. Opening the panel also puts
+// the CLI to work: the helpers only run while a panel asks for a refresh.
+//
+// The root is the shell's CardStack, taken from the shell directory itself:
+// a bare or path import of the file is not a type in this Quickshell build.
+Pond.CardStack {
+  id: root
+
+  required property var state
+
+  // Keys must match the entry page names CardStack pushes.
+  pageComponents: ({usage: listComponent, provider: providerComponent})
+  // A provider that leaves the snapshot while its page is open falls back to
+  // the list instead of showing a blank page.
+  onTransitionRunningChanged: {
+    if (transitionRunning || currentPage !== "provider")
+      return;
+    const id = currentSelection ? currentSelection.id : "";
+    if (!root.state.entries.some(entry => entry.id === id))
+      pop(false);
+  }
+
+  // A provider (or null) to show once the drawer is open. CardStack seeds
+  // itself with the list page on open, so a provider page needs a push after.
+  property var pendingEntry: null
+
+  // A tile that names a provider opens its page. A null entry, from the card
+  // body, opens the list.
+  function openProvider(entry) {
+    if (!opened || transitionRunning) {
+      pendingEntry = entry || null;
+      return;
+    }
+    if (!entry) {
+      if (currentPage !== "usage")
+        push("usage", null);
+      return;
+    }
+    if (root.state.entries.length === 0)
+      return;
+    push("provider", { id: entry.id, provider: entry.provider });
+  }
+
+  function applyPending() {
+    const entry = pendingEntry;
+    if (!entry)
+      return;
+    if (transitionRunning || currentPage !== "usage") {
+      Qt.callLater(root.applyPending);
+      return;
+    }
+    pendingEntry = null;
+    openProvider(entry);
+  }
+
+  onOpenedChanged: {
+    if (opened) {
+      root.state.noteDemand();
+      Qt.callLater(root.applyPending);
+    }
+  }
+
+  Component {
+    id: listComponent
+    List {
+      pageState: root.state
+    }
+  }
+
+  Component {
+    id: providerComponent
+    ProviderPage {
+      pageState: root.state
+    }
+  }
+}
