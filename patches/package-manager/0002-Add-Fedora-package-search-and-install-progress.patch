+        use std::cell::RefCell;
+        let mut command = Command::new("/bin/sh");
+        command.args(["-c", "test -t 1 && test -t 2 && ! test -t 0 || exit 8; printf 'Total 90%%\\rTransaction Summary:\\n[1/2] Total 25%% | 1 MiB\\r[2/2] Total 75%% | 3 MiB\\rerror text\\n'; exit 42"]);
+        let values = RefCell::new(Vec::new());
