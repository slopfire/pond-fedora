+fn run_with_progress(mut command: Command, report: impl Fn(f64)) -> Result<Output> {
+    let mut master = -1;
+    let mut slave = -1;
+    let size = libc::winsize {
+        ws_row: 24,
+        ws_col: 100,
+        ws_xpixel: 0,
+        ws_ypixel: 0,
+    };
+    // Both descriptors belong to this process on success and are closed by File.
+    let rc = unsafe {
+        libc::openpty(
+            &mut master,
+            &mut slave,
+            std::ptr::null_mut(),
+            std::ptr::null(),
+            &size,
+        )
+    };
+    if rc != 0 {
+        return Err(io::Error::last_os_error()).context("opening DNF progress terminal");
+    }
+    let mut master = unsafe { File::from_raw_fd(master) };
+    let slave = unsafe { File::from_raw_fd(slave) };
+    for fd in [master.as_raw_fd(), slave.as_raw_fd()] {
+        if unsafe { libc::fcntl(fd, libc::F_SETFD, libc::FD_CLOEXEC) } == -1 {
+            return Err(io::Error::last_os_error()).context("protecting DNF terminal descriptors");
+        }
+    }
+    command
+        .stdin(Stdio::null())
+        .stdout(Stdio::from(slave.try_clone()?))
+        .stderr(Stdio::from(slave));
+    let mut child = command.spawn().context("starting DNF")?;
+    // Command retains its stdio handles after spawn, so close them before reading.
+    drop(command);
+    let mut output = Vec::new();
+    let mut line = Vec::new();
+    let mut transaction = false;
+    let mut buffer = [0; 4096];
+    let read_result = loop {
+        match master.read(&mut buffer) {
+            Ok(0) => break Ok(()),
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+            Err(error) if error.raw_os_error() == Some(libc::EIO) => break Ok(()),
+            Err(error) => break Err(error),
+            Ok(count) => {
+                for &byte in &buffer[..count] {
+                    if byte == b'\r' || byte == b'\n' {
+                        if line
+                            .windows(b"Transaction Summary:".len())
+                            .any(|part| part == b"Transaction Summary:")
+                        {
+                            transaction = true;
+                        } else if transaction {
+                            if let Some(progress) = parse_progress(&line) {
+                                report(progress);
+                            }
+                        }
+                        line.clear();
+                    } else if line.len() < 8192 {
+                        line.push(byte);
+                    }
+                }
+                output.extend_from_slice(&buffer[..count]);
+                if output.len() > 16384 {
+                    output.drain(..output.len() - 16384);
+                }
+            }
+        }
+    };
+    let status = child.wait()?;
+    read_result.context("reading DNF progress")?;
+    Ok(Output {
+        status,
+        stdout: output,
+        stderr: Vec::new(),
+    })
+}
+
+fn parse_progress(line: &[u8]) -> Option<f64> {
+    let text = std::str::from_utf8(line).ok()?;
+    let (_, total) = text.split_once("Total")?;
+    let (before_percent, _) = total.split_once('%')?;
+    let percent: f64 = before_percent.split_whitespace().last()?.parse().ok()?;
+    (0.0..=100.0).contains(&percent).then_some(percent * 0.009)
+}
