+        let root = tempfile::tempdir().unwrap();
+        let mut command = Command::new(DNF);
+        command
+            .args([
+                format!("--installroot={}", root.path().display()),
+                "--releasever=44".into(),
+                "--setopt=reposdir=/dev/null".into(),
+                format!("--repofrompath=fixture,file://{fixture}"),
+                "--setopt=fixture.gpgcheck=0".into(),
+                "--assumeyes".into(),
+                "install".into(),
+                "--downloadonly".into(),
+                "pond-test".into(),
+            ])
+            .env("LC_ALL", "C");
+        let values = RefCell::new(Vec::new());
+        let result = run_with_progress(command, |value| values.borrow_mut().push(value)).unwrap();
+        assert!(
+            result.status.success(),
+            "{}",
+            String::from_utf8_lossy(&result.stdout)
+        );
+        assert!(
+            !values.borrow().is_empty(),
