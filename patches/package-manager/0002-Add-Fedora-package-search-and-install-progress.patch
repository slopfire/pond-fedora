+fn parse_packages(output: &str) -> BTreeMap<String, String> {
+    let mut packages = BTreeMap::new();
+    for line in output.lines() {
+        if let Some((name, summary)) = line.split_once('\t') {
+            if valid_package_name(name) {
+                packages
+                    .entry(name.to_owned())
+                    .or_insert_with(|| summary.to_owned());
+            }
+        }
+    }
+    packages
+}
+
+fn make_catalog(
+    apps: Vec<App>,
+    packages: BTreeMap<String, String>,
+) -> Result<(Vec<App>, Vec<App>)> {
+    let names = packages.keys().cloned().collect();
+    let apps = catalog_for_packages(apps, &names);
+    let mapped: HashSet<_> = apps
+        .iter()
+        .filter(|a| a.package_source.manager == "dnf")
+        .map(|a| a.package_source.package.as_str())
         .collect();
-    Ok(catalog_for_packages(apps, &names))
+    let mut ids: HashSet<_> = apps.iter().map(|a| a.id).collect();
+    let mut native = Vec::new();
+    for (name, summary) in &packages {
+        if mapped.contains(name.as_str()) {
+            continue;
+        }
+        // Keep IDs stable across repository changes and exact in JavaScript.
+        let hash = name.bytes().fold(0xcbf29ce484222325u64, |hash, byte| {
+            (hash ^ u64::from(byte)).wrapping_mul(0x100000001b3)
+        });
+        let id = (1u64 << 52) | (hash & ((1u64 << 52) - 1));
+        ensure!(
+            ids.insert(id),
+            "duplicate catalog ID for RPM package {name}"
+        );
+        native.push(App {
+            id,
+            name: name.clone(),
+            description: summary.clone(),
+            package_source: crate::PackageSource {
+                manager: "dnf".into(),
+                package: name.clone(),
+            },
+            traffic: 0,
+            icon: None,
+        });
+    }
+    Ok((apps, native))
 }
 
