+
+fn merge_results(curated: Vec<App>, native: &[App], query: &str, limit: usize) -> Vec<App> {
+    if limit == 0 {
+        return Vec::new();
+    }
+    let query = query.trim().to_ascii_lowercase();
+    if query.is_empty() {
+        return curated.into_iter().take(limit).collect();
+    }
+    let mut matches: Vec<_> = native
+        .iter()
+        .filter_map(|app| {
+            let name = app.name.to_ascii_lowercase();
+            let rank = if name == query {
+                0
+            } else if name.starts_with(&query) {
+                1
+            } else if name.contains(&query) {
+                2
+            } else if app.description.to_ascii_lowercase().contains(&query) {
+                3
+            } else {
+                return None;
+            };
+            Some((rank, app))
+        })
+        .collect();
+    matches.sort_unstable_by(|(a, x), (b, y)| a.cmp(b).then_with(|| x.name.cmp(&y.name)));
+    let exact = matches
+        .iter()
+        .take_while(|(rank, _)| *rank == 0)
+        .count()
+        .min(limit);
+    let mut result: Vec<_> = matches
+        .iter()
+        .take(exact)
+        .map(|(_, app)| (*app).clone())
+        .collect();
+    let native_quota = (limit / 2).max(1).min(matches.len());
+    let curated_quota = limit.saturating_sub(native_quota.max(exact));
+    let curated_count = curated.len().min(curated_quota);
+    result.extend(curated.iter().take(curated_count).cloned());
+    result.extend(
+        matches
+            .iter()
+            .skip(exact)
+            .take(limit - result.len())
+            .map(|(_, app)| (*app).clone()),
+    );
+    result.extend(
+        curated
+            .into_iter()
+            .skip(curated_count)
+            .take(limit - result.len()),
+    );
+    result
 }
 
