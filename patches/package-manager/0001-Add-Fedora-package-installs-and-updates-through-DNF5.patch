@@ -0,0 +1,88 @@
+use std::fs;
+
+use anyhow::{Context, Result};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum SystemPackageManager {
+    Dnf,
+    Paru,
+}
+
+impl SystemPackageManager {
+    pub(crate) fn detect() -> Result<Self> {
+        let release = fs::read_to_string("/etc/os-release").context("reading /etc/os-release")?;
+        Ok(Self::from_os_release(&release))
+    }
+
+    fn from_os_release(release: &str) -> Self {
+        for line in release.lines() {
+            if let Some((key, value)) = line.split_once('=') {
+                if matches!(key.trim(), "ID" | "ID_LIKE")
+                    && value
+                        .trim()
+                        .trim_matches(['\'', '"'])
+                        .split_whitespace()
+                        .any(|id| id == "fedora")
+                {
+                    return Self::Dnf;
+                }
+            }
+        }
+        Self::Paru
+    }
+
+    pub(crate) fn name(self) -> &'static str {
+        match self {
+            Self::Dnf => "DNF",
+            Self::Paru => "Paru",
+        }
+    }
+
+    pub(crate) fn update(self) -> Result<()> {
+        match self {
+            Self::Dnf => crate::dnf::update(),
+            Self::Paru => crate::paru::update(),
+        }
+    }
+
+    pub(crate) fn restart_recommended(self) -> Result<bool> {
+        match self {
+            Self::Dnf => crate::dnf::restart_recommended(),
+            Self::Paru => crate::update::restart_recommended(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn fedora_and_its_derivatives_use_dnf() {
+        for release in [
+            "ID=fedora\n",
+            "ID=\"fedora\"\n",
+            "ID=example\nID_LIKE=\"rhel fedora\"\n",
+        ] {
+            assert_eq!(
+                SystemPackageManager::from_os_release(release),
+                SystemPackageManager::Dnf
+            );
+        }
+    }
+
+    #[test]
+    fn other_systems_keep_the_upstream_backend() {
+        for release in [
+            "ID=arch\n",
+            "ID=endeavouros\nID_LIKE=arch\n",
+            "NAME=Fedora\nID=example\n",
+            "ID=not-fedora\n",
+        ] {
+            assert_eq!(
+                SystemPackageManager::from_os_release(release),
+                SystemPackageManager::Paru
+            );
+        }
+    }
+}
