diff --git a/libpm/src/dnf.rs b/libpm/src/dnf.rs
new file mode 100644
index 0000000000000000000000000000000000000000..49c2c421aac401c47a40ccd627dcce9f3dd927b5
--- /dev/null
+++ b/libpm/src/dnf.rs
@@ -0,0 +1,301 @@
+use std::{
+    collections::HashSet,
+    process::{Command, Output, Stdio},
+};
+
+use anyhow::{bail, ensure, Context, Result};
+use serde::Deserialize;
+
+use crate::{App, InstallOutcome};
+
+const DNF: &str = "/usr/bin/dnf5";
+
+fn command() -> Command {
+    let mut command = Command::new(DNF);
+    command.env("LC_ALL", "C").stdin(Stdio::null());
+    command
+}
+
+fn privileged_command() -> Command {
+    let mut command = Command::new("/usr/bin/pkexec");
+    command
+        .arg(DNF)
+        .arg("--assumeyes")
+        .env("LC_ALL", "C")
+        .stdin(Stdio::null());
+    command
+}
+
+fn failure(output: &Output, action: &str) -> anyhow::Error {
+    let diagnostic = if output.stderr.is_empty() {
+        &output.stdout
+    } else {
+        &output.stderr
+    };
+    let diagnostic: String = String::from_utf8_lossy(diagnostic)
+        .trim()
+        .chars()
+        .take(4096)
+        .collect();
+    anyhow::anyhow!("{action} failed ({}): {diagnostic}", output.status)
+}
+
+pub(crate) fn updates_available() -> Result<bool> {
+    let output = command()
+        .args(["--quiet", "check-upgrade"])
+        .output()
+        .context("checking DNF updates")?;
+    check_update_output(&output)
+}
+
+fn check_update_output(output: &Output) -> Result<bool> {
+    match output.status.code() {
+        Some(0) => Ok(false),
+        Some(100) => Ok(true),
+        _ => Err(failure(output, "checking DNF updates")),
+    }
+}
+
+pub(crate) fn update() -> Result<()> {
+    let output = privileged_command()
+        .args(["upgrade", "--refresh"])
+        .output()
+        .context("starting DNF upgrade through pkexec")?;
+    ensure!(
+        output.status.success(),
+        "{}",
+        failure(&output, "upgrading RPM packages")
+    );
+    Ok(())
+}
+
+pub(crate) fn install(package: &str) -> Result<InstallOutcome> {
+    let output = install_command(package)?
+        .output()
+        .with_context(|| format!("installing {package} through pkexec"))?;
+    ensure!(
+        output.status.success(),
+        "{}",
+        failure(&output, &format!("installing {package} with DNF"))
+    );
+    Ok(InstallOutcome::Installed)
+}
+
+fn install_command(package: &str) -> Result<Command> {
+    // Accept one repository package name. DNF also accepts paths, URLs, groups,
+    // and wildcard specs, which must not come from the app catalog.
+    ensure!(
+        package
+            .bytes()
+            .next()
+            .is_some_and(|c| c.is_ascii_alphanumeric())
+            && package
+                .bytes()
+                .all(|c| c.is_ascii_alphanumeric() || b"+._-".contains(&c)),
+        "invalid RPM package name {package:?}"
+    );
+    let mut command = privileged_command();
+    command.args(["install", "--", package]);
+    Ok(command)
+}
+
+#[derive(Deserialize)]
+struct RestartHint {
+    #[serde(rename = "type")]
+    kind: String,
+    reboot_required: bool,
+}
+
+pub(crate) fn restart_recommended() -> Result<bool> {
+    // The reboot hint only needs the installed RPM database. Disable remote
+    // repositories so this check cannot refresh metadata or ask to import keys.
+    let output = command()
+        .args([
+            "--cacheonly",
+            "--disable-repo=*",
+            "needs-restarting",
+            "--json",
+        ])
+        .output()
+        .context("checking the DNF reboot hint")?;
+    restart_output(&output)
+}
+
+fn restart_output(output: &Output) -> Result<bool> {
+    if !matches!(output.status.code(), Some(0 | 1)) {
+        return Err(failure(output, "checking the DNF reboot hint"));
+    }
+    let hints: Vec<RestartHint> = serde_json::from_slice(&output.stdout).with_context(|| {
+        format!(
+            "invalid DNF reboot hint: {}",
+            failure(output, "checking the DNF reboot hint")
+        )
+    })?;
+    let hint = hints
+        .iter()
+        .find(|hint| hint.kind == "reboot")
+        .context("DNF returned no reboot hint")?;
+    ensure!(
+        hint.reboot_required == (output.status.code() == Some(1)),
+        "DNF reboot hint and exit status disagree"
+    );
+    Ok(hint.reboot_required)
+}
+
+pub(crate) fn catalog(apps: Vec<App>) -> Result<Vec<App>> {
+    let output = command()
+        .args([
+            "--cacheonly",
+            "--quiet",
+            "repoquery",
+            "--available",
+            "--arch",
+        ])
+        .arg(format!("{},noarch", std::env::consts::ARCH))
+        .args(["--queryformat", "%{name}\n"])
+        .output()
+        .context("loading Fedora repository package names")?;
+    if !output.status.success() {
+        bail!(
+            "{}. Refresh repository metadata with dnf5 makecache, then try again",
+            failure(&output, "loading Fedora repository package names")
+        );
+    }
+    let names: HashSet<_> = std::str::from_utf8(&output.stdout)
+        .context("reading DNF package names")?
+        .lines()
+        .map(str::to_owned)
+        .collect();
+    Ok(catalog_for_packages(apps, &names))
+}
+
+fn catalog_for_packages(apps: Vec<App>, names: &HashSet<String>) -> Vec<App> {
+    apps.into_iter()
+        .filter_map(|mut app| {
+            if matches!(app.package_source.manager.as_str(), "pacman" | "aur") {
+                let package = match app.package_source.package.as_str() {
+                    "apache" => "httpd",
+                    "appstream-glib" => "libappstream-glib",
+                    "baloo" => "kf6-baloo",
+                    "brave-bin" => "brave-browser",
+                    "discover" => "plasma-discover",
+                    "gcc-fortran" => "gcc-gfortran",
+                    "github-cli" => "gh",
+                    "go" => "golang",
+                    "gptfdisk" => "gdisk",
+                    "graphicsmagick" => "GraphicsMagick",
+                    "gvim" => "vim-X11",
+                    "libreoffice-fresh" => "libreoffice",
+                    "zen-browser-bin" => "zen-browser",
+                    package => package,
+                };
+                if !names.contains(package) {
+                    return None;
+                }
+                app.package_source.package = package.to_owned();
+                app.package_source.manager = "dnf".into();
+            }
+            Some(app)
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::process::ExitStatusExt;
+
+    fn output(code: i32, stdout: &str, stderr: &str) -> Output {
+        Output {
+            status: std::process::ExitStatus::from_raw(code << 8),
+            stdout: stdout.into(),
+            stderr: stderr.into(),
+        }
+    }
+
+    #[test]
+    fn check_distinguishes_updates_no_updates_and_failures() {
+        assert!(!check_update_output(&output(0, "", "")).unwrap());
+        assert!(check_update_output(&output(100, "an update", "")).unwrap());
+        for code in [1, 2, 126, 127] {
+            let error =
+                check_update_output(&output(code, "", "repository unavailable")).unwrap_err();
+            assert!(error.to_string().contains("repository unavailable"));
+        }
+        let killed = Output {
+            status: std::process::ExitStatus::from_raw(9),
+            stdout: vec![],
+            stderr: vec![],
+        };
+        assert!(check_update_output(&killed).is_err());
+    }
+
+    #[test]
+    fn reboot_hint_requires_valid_json_and_matching_exit_status() {
+        let no = r#"[{"type":"reboot","reboot_required":false}]"#;
+        let yes = r#"[{"type":"reboot","reboot_required":true}]"#;
+        assert!(!restart_output(&output(0, no, "")).unwrap());
+        assert!(restart_output(&output(1, yes, "")).unwrap());
+        for (code, text) in [(1, ""), (1, no), (0, yes), (0, "[]"), (2, yes)] {
+            assert!(restart_output(&output(code, text, "plugin error")).is_err());
+        }
+    }
+
+    #[test]
+    fn install_uses_pkexec_with_one_package_and_rejects_other_specs() {
+        let command = install_command("example-app+plugin.x86_64").unwrap();
+        assert_eq!(command.get_program(), "/usr/bin/pkexec");
+        assert_eq!(
+            command.get_args().collect::<Vec<_>>(),
+            [
+                DNF,
+                "--assumeyes",
+                "install",
+                "--",
+                "example-app+plugin.x86_64"
+            ]
+        );
+        for package in [
+            "",
+            "--allowerasing",
+            "@desktop",
+            "a*",
+            "/tmp/app.rpm",
+            "https://example.invalid/a.rpm",
+            "a b",
+            "a;id",
+            "a\nb",
+        ] {
+            assert!(install_command(package).is_err(), "accepted {package:?}");
+        }
+    }
+
+    #[test]
+    fn catalog_reuses_metadata_and_only_maps_available_native_packages() {
+        let app = |id, manager: &str, package: &str| App {
+            id,
+            name: format!("App {id}"),
+            description: "upstream description".into(),
+            traffic: 42,
+            icon: Some("upstream-icon".into()),
+            package_source: crate::PackageSource {
+                manager: manager.into(),
+                package: package.into(),
+            },
+        };
+        let apps = vec![
+            app(1, "pacman", "libreoffice-fresh"),
+            app(2, "aur", "available-app"),
+            app(3, "pacman", "arch-only"),
+            app(4, "flatpak", "org.example.App"),
+        ];
+        let names = HashSet::from(["libreoffice".into(), "available-app".into()]);
+        let apps = catalog_for_packages(apps, &names);
+        assert_eq!(apps.iter().map(|a| a.id).collect::<Vec<_>>(), [1, 2, 4]);
+        assert_eq!(apps[0].package_source.manager, "dnf");
+        assert_eq!(apps[0].package_source.package, "libreoffice");
+        assert_eq!(apps[0].description, "upstream description");
+        assert_eq!(apps[0].icon.as_deref(), Some("upstream-icon"));
+        assert_eq!(apps[2].package_source.manager, "flatpak");
+    }
+}
